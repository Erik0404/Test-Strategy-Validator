% =====================================================================
% MANUAL TEST SCENARIO T4 - "Emergency stop between two platforms"
% =====================================================================
% Hand-written by the test engineer, NOT generated by the LLM.
% Complementary to T3 in BOTH decision dimensions:
%   cause    = PassengerAlarm        (T3 used ObstacleDetected)
%   location = OutsideStoppingWindow (T3 used WithinStoppingWindow)
%
% What the metamodel derives automatically:
%   * missingEmergencyBubble              -> EmergencyBubble on all five ports
%   * doorsOpenOutsideStoppingWindow      -> emDoors must be DoorsClosed
%   * evacuationWithoutPlatformEmergency  -> NO EvacuationBubble object
%   * regularBubbleDuringEmergency        -> no ArrivalEvent / DepartureEvent /
%                                            StandstillBubble object at all
% =====================================================================

EmergencyStop(em1).
trainEvent(t1, em1).

PassengerAlarm(cause1).
emCause(em1, cause1).

OutsideStoppingWindow(window1).
emWindow(em1, window1).
